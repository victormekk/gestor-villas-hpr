# ANTES DE SALIR A INTERNET (ver la seccion "Seguridad" del README):
#   APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error
#   APP_URL, FRONTEND_URL y SANCTUM_STATEFUL_DOMAINS con el dominio real (no localhost)
#   SESSION_SECURE_COOKIE=true y SESSION_DOMAIN=.tudominio.com (requiere servir todo por HTTPS)
APP_NAME="Gestor de Villas HPR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Tegucigalpa
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Pruebas en la nube (Railway/Render u otro host con Postgres administrado): la mayoria entrega
# la cadena de conexion ya armada en la variable DATABASE_URL, que AppServiceProvider toma sola
# -- no hace falta llenar host/puerto/usuario aqui a mano. Solo hay que fijar el driver:
# DB_CONNECTION=pgsql

# Conexion real a TPVADMIN (SQL Server) -- NO activar hasta tener acceso de escritura confirmado
# y haber corrido docs/pending-verification.sql. Ver docs/new-schema-design.md.
# Host/puerto/usuario reales: ver informacion/conexion_db.txt (no versionado, solo en este equipo).
# DB_CONNECTION=sqlsrv
# DB_HOST=
# DB_PORT=
# DB_DATABASE=TPVADMIN
# DB_USERNAME=
# DB_PASSWORD=
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En produccion (con HTTPS): SESSION_SECURE_COOKIE=true -- si no, el navegador puede mandar la
# cookie de sesion por HTTP sin cifrar. En local (http://localhost) se deja sin definir.
# SESSION_SECURE_COOKIE=true
# Si el frontend y el backend quedan en DOMINIOS DISTINTOS (ej. Netlify + Railway, sin un dominio
# propio compartido), la cookie de sesion viaja entre sitios y el navegador exige SameSite=None
# (y por eso, a la vez, Secure=true). Con un dominio propio y subdominios para ambos, en cambio,
# se puede dejar en "lax" (mas seguro) y no hace falta nada de esto -- ver "Despliegue" en el README.
# SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF de reportes: "chrome" (rapido, usa Chrome/Chromium sin ventana) o "dompdf" (el motor anterior).
# Si CHROME_PATH queda vacio se busca Chrome o Edge en las rutas habituales; si no hay, se usa dompdf.
PDF_MOTOR=chrome
CHROME_PATH=
PDF_TIMEOUT=300
